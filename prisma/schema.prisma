generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum CategorySlug {
  THOUGHTS
  PRODUCT_PROGRESS
  ANNOUNCEMENTS
}

model Category {
  id          String       @id @default(cuid())
  slug        CategorySlug @unique
  name        String
  description String?
  posts       Post[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("categories")
}

model Post {
  id                  String     @id @default(cuid())
  title               String
  slug                String     @unique
  excerpt             String     @db.VarChar(320)
  body                String
  coverImageKey       String?    @map("cover_image_key")
  squareCoverImageKey String?    @map("square_cover_image_key")
  isFeatured          Boolean    @default(false) @map("is_featured")
  views               Int        @default(0)
  authorName          String     @default("") @map("author_name")
  authorIntro         String     @default("") @map("author_intro") @db.VarChar(500)
  authorAvatarKey     String?    @map("author_avatar_key")
  companyName         String     @default("myClawTeam") @map("company_name")
  companyIntro        String     @default("") @map("company_intro") @db.VarChar(500)
  companyLogoKey      String?    @map("company_logo_key")
  companyWebsiteUrl   String     @default("https://myclawteam.ai") @map("company_website_url")
  status              PostStatus @default(DRAFT)
  publishedAt         DateTime?  @map("published_at")
  categoryId          String     @map("category_id")
  category            Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([status, publishedAt])
  @@map("posts")
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(320)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("subscribers")
}
