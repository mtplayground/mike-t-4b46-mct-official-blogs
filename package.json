{
  "name": "mike-t-4b46-mct-official-blogs",
  "version": "1.0.0",
  "description": "myClawTeam official blog served by a Rust Axum backend with static Tailwind CSS.",
  "private": true,
  "scripts": {
    "dev": "PATH=/usr/local/cargo/bin:$PATH cargo run --manifest-path rust-backend/Cargo.toml",
    "build": "npm run build:css && npm run backend:build",
    "start": "./scripts/start-sprite.sh",
    "test": "node scripts/verify-no-next-runtime.mjs",
    "test:all": "npm run test && npm run backend:test",
    "e2e": "playwright test",
    "env:check": "tsx scripts/check-env.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "backend:dev": "PATH=/usr/local/cargo/bin:$PATH cargo run --manifest-path rust-backend/Cargo.toml",
    "backend:build": "PATH=/usr/local/cargo/bin:$PATH cargo build --release --manifest-path rust-backend/Cargo.toml",
    "backend:test": "PATH=/usr/local/cargo/bin:$PATH cargo test --manifest-path rust-backend/Cargo.toml",
    "build:backend": "npm run backend:build",
    "build:css": "./scripts/build-css.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtplayground/mike-t-4b46-mct-official-blogs.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mtplayground/mike-t-4b46-mct-official-blogs/issues"
  },
  "homepage": "https://github.com/mtplayground/mike-t-4b46-mct-official-blogs#readme",
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
