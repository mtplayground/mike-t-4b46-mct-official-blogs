{
  "name": "mike-t-4b46-mct-official-blogs",
  "version": "1.0.0",
  "description": "myClawTeam official blog built with Next.js App Router.",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 8080",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-8080}",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "e2e": "playwright test",
    "env:check": "tsx scripts/check-env.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtplayground/mike-t-4b46-mct-official-blogs.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/mtplayground/mike-t-4b46-mct-official-blogs/issues"
  },
  "homepage": "https://github.com/mtplayground/mike-t-4b46-mct-official-blogs#readme",
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1066.0",
    "@aws-sdk/s3-request-presigner": "^3.1066.0",
    "@prisma/client": "^6.19.3",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
