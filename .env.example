# Public canonical URL for absolute links and auth redirects.
SELF_URL=http://localhost:8080

# Bare self-hosted runtime port. The packaged start script binds 0.0.0.0 and uses PORT.
PORT=8080

# PostgreSQL connection string. Production uses the pre-provisioned myClawTeam PostgreSQL database.
DATABASE_URL=postgresql://blog_user:blog_password@localhost:5432/myclawteam_official_blogs?schema=public

# Admin credentials used by the admin auth flow.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-jwt-secret

# Secret used by the Rust backend to ask Next.js to revalidate public ISR pages.
# Defaults to JWT_SECRET if omitted; set explicitly to rotate independently.
REVALIDATE_SECRET=replace-with-a-long-random-revalidate-secret
# Optional override when Rust must call a private/internal Next.js origin.
# REVALIDATE_URL=http://127.0.0.1:8080/api/revalidate

# S3-compatible object storage. The app uses the vendor-neutral OBJECT_STORAGE_* scheme.
OBJECT_STORAGE_ACCESS_KEY_ID=example-access-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=example-secret-access-key
OBJECT_STORAGE_BUCKET=example-private-bucket
OBJECT_STORAGE_PREFIX=app_mike_t_4b46_mct_official_blogs_a6d6ca/
OBJECT_STORAGE_ENDPOINT=https://fly.storage.tigris.dev
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_FORCE_PATH_STYLE=true
